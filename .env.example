# Optional: Google sign-in and syncing plans across devices.
# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > General > Your apps > Web app > SDK setup and config).
# Leave them empty and the app runs without sign-in, saving plans in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "demo" to try the sign-in flow with a stand-in account kept in this
# browser (no Firebase project needed). Never set this for a real deployment.
# VITE_CLOUD=demo
